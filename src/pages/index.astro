---
// The house is generated by art/page.py from the pixel-art layout; edit there, then `npm run art`.
import house from '../generated/house.html?raw';
import '@fontsource/pixelify-sans/400.css';
import '@fontsource/pixelify-sans/500.css';
import '@fontsource/pixelify-sans/600.css';
import '@fontsource/pixelify-sans/700.css';
import '../styles/house.css';

const title = 'Nick Lemoff';
const description = 'Nick Lemoff. I work on agent evals at Judgment Labs.';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#161a3a">
<link rel="canonical" href="https://www.nlemoff.com/">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.nlemoff.com/">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content="https://www.nlemoff.com/og.png">
<meta property="og:image:alt" content="Nick Lemoff, in pixel letters over a night sky above a house in Oakland.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@nlemoff">
</head>
<body>
<Fragment set:html={house} />
<script src="../scripts/house.js"></script>
</body>
</html>
